# Access key for API and WebSocket authentication (required)
ACCESS_KEY=

# Server
# HOST defaults to localhost to keep the server bound to the loopback interface.
# For remote access, prefer a secure tunnel over changing HOST to 0.0.0.0 or a LAN/external interface.
HOST=localhost
PORT=3101

# CORS allowed origins (comma-separated)
# If you set up a reverse proxy (e.g. nginx), remember to add the proxy's origin here.
CORS_ORIGINS=http://localhost:5101,http://localhost:3101

# Runtime
# LOG_LEVEL defaults to "debug" in development, "info" otherwise. Common values: trace, debug, info, warn, error.
# LOG_LEVEL=info

# Directory for Crow file-based storage.
# Defaults to ~/.crow (user home) when unset. Relative paths resolve from cwd;
# paths starting with ~ expand to the user's home directory.
# CROW_SYSTEM_PATH=

# Custom name for the Crow system agent (default: "Crow")
# CROW_SYSTEM_AGENT_NAME=Crow

# Static file directory for serving frontend assets (optional, auto-detected from dist)
# STATIC_PATH=

# Override path to the Claude Code CLI executable (optional, auto-detected when unset)
# CLAUDE_CLI_PATH=

# Disable GitHub Copilot agents entirely. When true (or 1), the backend skips starting the
# Copilot SDK client at boot, so Copilot is reported unavailable everywhere. Defaults to false.
# DISABLE_GITHUB_COPILOT=false

# Override the Copilot CLI runtime the SDK spawns. Read directly by @github/copilot-sdk.
# COPILOT_CLI_PATH=

# Number of days to retain closed tasks before pruning on startup (default: 30)
# CLOSED_TASK_RETENTION_DAYS=30

# Number of days to retain feed items before pruning (default: 30)
# FEED_ITEM_RETENTION_DAYS=30

# How often the feed manager refreshes feeds, in minutes (default set in code)
# FEED_REFRESH_IN_MINUTES=15

# OpenAI-compatible chat completion API - not used at the moment
# Provider can be: ANTHROPIC, GOOGLE, OPENAI, CUSTOM
# TEXT_GENERATION_PROVIDER=CUSTOM
# TEXT_GENERATION_API_KEY=
# Base URL only required for CUSTOM provider; known providers use their default endpoints
# TEXT_GENERATION_BASE_URL=http://localhost:8080/v1
# TEXT_GENERATION_MODEL=default

# Used by the feed manager to summarize feed item content. Optional, but recommended:
# summaries normalize feed items to a consistent length, giving agents a more uniform
# and higher-quality signal when consuming feeds. Same provider options as above.
# FEED_TEXT_GENERATION_PROVIDER=
# FEED_TEXT_GENERATION_API_KEY=
# FEED_TEXT_GENERATION_BASE_URL=
# FEED_TEXT_GENERATION_MODEL=

# Maximum number of feed items the manager will summarize in a single refresh
# (default: 50). Items left unsummarized in a refresh become retry candidates on
# the next refresh. When the retry backlog exceeds this cap, retries are skipped
# for that refresh - giving up on older unsummarized items so a feed isn't
# permanently blocked by hundreds or thousands of stuck items.
# FEED_MAX_SUMMARIZATION_ITEMS=50

# Audio generation (text-to-speech) for the play-message feature on the agent console.
# Currently only GOOGLE is supported (Gemini TTS via google-genai). MODEL must be a
# Gemini TTS model id (e.g. gemini-2.5-flash-preview-tts or gemini-3.1-flash-tts-preview).
# AUDIO_GENERATION_PROVIDER=GOOGLE
# AUDIO_GENERATION_API_KEY=
# AUDIO_GENERATION_MODEL=gemini-2.5-flash-preview-tts

# OAuth connectors. Required only if you want agents to use a connector
# (currently: Google -> Gmail tools, with Calendar and Contacts scopes also
# granted at sign-in for future tool families).
#
# See README.md "Connectors" section for the full setup walkthrough.
# GOOGLE_CONNECTOR_CLIENT_ID=
# GOOGLE_CONNECTOR_CLIENT_SECRET=
# CONNECTOR_CALLBACK_URL=http://localhost:3101/auth/callback

# How long an unfinished OAuth flow stays valid before being swept (default: 10 minutes).
# OAUTH_PENDING_STATE_TTL_MS=600000

# How often the Gmail notification routine polls for new mail, in minutes (default: 15).
# Only agents with the Gmail MCP server enabled AND enableGmailNotification set are checked.
# GMAIL_CHECK_INTERVAL_IN_MINUTES=15

# Default places provider for lookups without an explicit source: OSM (default) or GOOGLE.
# GOOGLE requires GOOGLE_PLACES_API_KEY below; otherwise it falls back to OSM.
# PLACES_DEFAULT_SOURCE=OSM

# Google Places source for the places tools. Optional: when GOOGLE_PLACES_API_KEY
# is set, the Google adapter is registered alongside the default OSM source.
# The key requires the Places API (New) and the Geocoding API (v4) enabled.
# GOOGLE_PLACES_API_KEY=

# OpenTelemetry (disabled by default)
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=crow-central-agency
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
