{
  "name": "@crow-central-agency/shared",
  "version": "0.27.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch --project ./tsconfig.build.json",
    "build": "tsc --project ./tsconfig.build.json",
    "postbuild": "node ../../scripts/copy-to-root-dist.mjs _shared",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
